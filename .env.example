# Local preview origin. Replace with the approved origin before publishing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# public: approved repository content and unavailable commerce actions
# demo: development-only labelled fixtures; live: explicit Express connection
OFFMARK_DATA_MODE=public

# Required only for live mode. Must be an HTTP(S) origin, with no path.
OFFMARK_API_ORIGIN=

# Development-only deterministic scenario. See src/data/demo/scenarios.ts.
OFFMARK_DEMO_SCENARIO=success
